{
  "name": "cocos-challenge-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node scripts/seed.mjs",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "npm run test:unit && npm run test:functional",
    "test:unit": "npm run prisma:generate && vitest run --exclude test/orders.functional.spec.ts",
    "test:functional": "npm run prisma:generate && node scripts/test-functional.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@types/node": "24.10.0",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
